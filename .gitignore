__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
# Sweep output. `tools/sweep.py` defaults to ~/.sih141/results, OUTSIDE the
# repository, because raw per-trial files are never committed -- only the
# reduced tables are. These cover the case of someone pointing --results at
# the working copy.
results/
sweep-results/
.sih141/

# The working journal: individual entries under `journal/entries/` and the
# `JOURNAL.md` that `tools/journal.py render` builds from them. It was the
# build-time decision log and Phase 7 ended it, so it leaves the repository
# rather than shipping 92k words of scaffolding to a reader. Both stay on disk.
journal/
JOURNAL.md

# Editor and dev-server configuration. `launch.json` names a local port for the
# preview pane, which is tooling for whoever is working on this, not part of it.
.claude/
